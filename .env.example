# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!
#
# NewsForMe runs with NONE of these set. arXiv and Crossref are free and need
# no key, and the app falls back to keyword-only ranking without a model.

# --- Model review layer (optional) ---
# Without this, briefings are ranked by keyword/venue/recency only and the
# "Why you" lines are generated from your matched keywords.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Any OpenRouter model slug. A cheap, fast model is plenty for this job.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Used only to estimate per-briefing cost shown in the build log.
MODEL_INPUT_USD_PER_MTOK=1.00
MODEL_OUTPUT_USD_PER_MTOK=5.00

# --- Analytics (Build 2) ---
# Leave blank until Build 2; the snippet is only injected when a key is set.
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Optional ---
# Crossref asks automated clients to identify themselves. Supplying an address
# puts you in their faster "polite pool". Entirely optional.
CROSSREF_CONTACT_EMAIL=

# Where the SQLite file lives.
NEWSFORME_DB=newsforme.db
