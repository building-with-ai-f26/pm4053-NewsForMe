{
  // Must match the Worker name in the Cloudflare dashboard.
  // Without this, the build names the Worker after the GitHub repo path
  // ("piyushm101-newsforme-daily-brief"), and Cloudflare Workers Builds
  // fails because the names do not match.
  "name": "newsforme-daily-brief",
  "previews": {
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "issues": {
        "enabled": false
      },
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
        "persist": true
      }
    }
  }
}
